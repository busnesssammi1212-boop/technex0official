<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Google Login Test</title>
    
    
    <script src="https://google.com" async defer></script>
</head>
<body>

    <h2>Login to Your Account</h2>

    <!-- 2. The Google Sign-In Button Container -->
    <div id="buttonDiv"></div>

    <script>
        // 3. Callback function that runs automatically after a user successfully logs in
        function handleCredentialResponse(response) {
            console.log("Encoded JWT ID token: " + response.credential);
            
            // You can parse this token or send it to your backend server here
            alert("Login successful! Check your browser console to see the user token.");
        }

        // 4. Initialize and render the button when the window loads
        window.onload = function () {
            google.accounts.id.initialize({
                client_id: "743959660259-kv0c54nn90kqoccdb1g6nnu7kf5beo9s.apps.googleusercontent.com",
                callback: handleCredentialResponse
            });

            google.accounts.id.renderButton(
                document.getElementById("buttonDiv"),
                { 
                    theme: "outline", 
                    size: "large",
                    text: "signin_with",
                    shape: "rectangular" 
                }  // Customization options
            );

            // Optional: Displays the "One Tap" floating login prompt on the top right
            google.accounts.id.prompt(); 
        }
    </script>

</body>
</html>
